digraph UML {
  rankdir=BT; nodesep=0.6; ranksep=0.9; splines=polyline;
  graph [fontname="Arial"];
  node [shape=record, fontname="Arial", fontsize=10, style=filled, fillcolor="#E0F2F1"];
  edge [fontname="Arial", fontsize=9];

  Main [fillcolor="#FFF3E0", label="{app::Main|+ main(args: String[]) : void\l- demostrarPolimorfismo() : void\l}"];
  Gestor [fillcolor="#E8EAF6", label="{servicio::GestorAlmacen|- anaqueles : List\<Anaquel\>\l- envios : List\<Envio\>\l|+ registrarPaquete(p: Paquete, fecha: LocalDate) : Envio\l+ buscarPaquete(codigo: String) : Paquete\l+ registrarEntrega(codigo, recibidoPor, fecha) : void\l+ calcularCostoAlmacenaje(codigo, hoy) : double\l+ getPendientes(dias, hoy) : List\<Envio\>\l+ getHistorial() : List\<Envio\>\l}"];
  Exc [label="{excepciones::AlmacenLlenoException|+ AlmacenLlenoException(mensaje: String)\l}"];
  Exception [fillcolor="#EEEEEE", label="{java.lang::Exception}"];
  Paquete [label="{modelo::Paquete|- codigo : String\l- pesoKg : double\l- estado : String\l- remitente : Remitente\l- destinatario : Destinatario\l- anaquel : Anaquel\l|+ calcularCostoAlmacenaje(dias: int) : double\l# validarDias(dias: int) : void\l+ setEstado(estado: String) : void\l+ setAnaquel(a: Anaquel) : void\l}"];
  Est [label="{modelo::PaqueteEstandar|- DIAS_GRATIS = 3\l- TARIFA_DIA = 5.0\l|+ calcularCostoAlmacenaje(dias: int) : double\l}"];
  Fra [label="{modelo::PaqueteFragil|- cargoManejo : double\l- TARIFA_DIA = 12.0\l|+ calcularCostoAlmacenaje(dias: int) : double\l}"];
  Rem [label="{modelo::Remitente|- nombre : String\l- telefono : String\l|+ setNombre(String) : void\l+ setTelefono(String) : void\l}"];
  Des [label="{modelo::Destinatario|- nombre : String\l- telefono : String\l|+ setNombre(String) : void\l+ setTelefono(String) : void\l}"];
  Ana [label="{modelo::Anaquel|- codigo : String\l- paquete : Paquete\l|+ ocupar(p: Paquete) : void\l+ liberar() : void\l+ estaLibre() : boolean\l}"];
  Env [label="{modelo::Envio|- fechaIngreso : LocalDate\l- fechaSalida : LocalDate\l- estado : String\l- paquete : Paquete\l- entrega : Entrega\l|+ cerrar(e: Entrega) : void\l+ estaActivo() : boolean\l}"];
  Ent [label="{modelo::Entrega|- fecha : LocalDate\l- recibidoPor : String\l}"];

  Est -> Paquete [arrowhead=empty];
  Fra -> Paquete [arrowhead=empty];
  Exc -> Exception [arrowhead=empty];
  Main -> Gestor [style=dashed, arrowhead=vee, label="usa"];
  Main -> Exc [style=dashed, arrowhead=vee, label="captura"];
  Gestor -> Exc [style=dashed, arrowhead=vee, label="lanza"];
  Gestor -> Ana [arrowhead=odiamond, headlabel="1..*", labeldistance=2];
  Gestor -> Env [arrowhead=odiamond, headlabel="0..*", labeldistance=2];
  Env -> Paquete [arrowhead=vee, label="1"];
  Env -> Ent [arrowhead=vee, headlabel="0..1", labeldistance=2];
  Ana -> Paquete [arrowhead=vee, headlabel="0..1", labeldistance=2];
  Paquete -> Rem [arrowhead=vee, headlabel="1", labeldistance=2];
  Paquete -> Des [arrowhead=vee, headlabel="1", labeldistance=2];
}
